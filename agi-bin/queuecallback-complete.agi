#!/usr/bin/php
<?php
/**
 * Queue Callback Completion AGI Script
 * Updates callback status when call completes
 */

$stdin = fopen('php://stdin', 'r');
$stdout = fopen('php://stdout', 'w');

// Read initial AGI environment variables from Asterisk
$agi_vars = array();
while ($line = fgets($stdin)) {
    $line = trim($line);
    if ($line == '') break; // Empty line signals end of environment
    
    if (strpos($line, ':') !== false) {
        list($key, $value) = explode(':', $line, 2);
        $agi_vars[trim($key)] = trim($value);
    }
}

// Get arguments passed to AGI
$callback_id = isset($agi_vars['agi_arg_1']) ? $agi_vars['agi_arg_1'] : '';
$status = isset($agi_vars['agi_arg_2']) ? $agi_vars['agi_arg_2'] : 'completed';

try {
    if (!empty($callback_id)) {
        // Direct database connection
        $pdo = new PDO("mysql:host=localhost;dbname=asterisk", "freepbxuser", "55f88989cd6491e23706671e66750db4");
        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
        
        // Update callback status
        $sql = "UPDATE queuecallback_requests SET status = ?, time_processed = ? WHERE id = ?";
        $stmt = $pdo->prepare($sql);
        $stmt->execute([$status, time(), $callback_id]);
        
        // Log completion
        error_log("Callback completed: ID $callback_id - Status: $status");
    }
    
} catch (Exception $e) {
    error_log("Callback completion error: " . $e->getMessage());
}
?>