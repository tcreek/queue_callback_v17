#!/usr/bin/php -q
<?php
/**
 * queuecallback-result.agi
 *
 * Alias for queuecallback-complete.agi — kept for backwards compatibility.
 * Marks a callback request as completed when called from either leg.
 */

require_once('/etc/freepbx.conf');

try {
    $fpbx = \FreePBX::Create();
    $db   = $fpbx->Database;
} catch (\Throwable $e) {
    // Drain AGI env then exit silently
    while (($l = fgets(STDIN)) !== false) { if (rtrim($l) === '') { break; } }
    exit(0);
}

function agi_read_env(): array {
    $env = [];
    while (($line = fgets(STDIN)) !== false) {
        $line = rtrim($line);
        if ($line === '') { break; }
        $pos = strpos($line, ':');
        if ($pos !== false) {
            $env[trim(substr($line, 0, $pos))] = trim(substr($line, $pos + 1));
        }
    }
    return $env;
}
function agi_cmd(string $cmd): string {
    fwrite(STDOUT, $cmd . "\n"); fflush(STDOUT);
    $r = fgets(STDIN); return ($r === false) ? '' : trim($r);
}
function agi_getvar(string $name): string {
    $r = agi_cmd("GET VARIABLE $name");
    return preg_match('/result=1\s*\(([^)]*)\)/', $r, $m) ? $m[1] : '';
}
function agi_verbose(string $msg, int $lvl = 1): void {
    agi_cmd('VERBOSE "' . addcslashes($msg, '"\\') . "\" $lvl");
}

$env  = agi_read_env();
$uniqueid = $env['agi_uniqueid'] ?? '';

$cb_id = agi_getvar('CALLBACK_ID');
if ($cb_id === '') { $cb_id = agi_getvar('__CALLBACK_ID'); }

if ($cb_id === '' || !ctype_digit($cb_id)) {
    agi_verbose('QCB RESULT: no valid CALLBACK_ID — nothing to mark');
    exit(0);
}

try {
    $st = $db->prepare(
        "UPDATE queuecallback_requests
            SET status         = 'completed',
                time_processed = ?,
                uniqueid       = COALESCE(NULLIF(uniqueid, ''), ?)
          WHERE id = ?
            AND status IN ('pending','processing')"
    );
    $st->execute([time(), $uniqueid, (int)$cb_id]);
    agi_verbose("QCB RESULT: marked callback id $cb_id as completed");
} catch (\Throwable $e) {
    agi_verbose('QCB RESULT: DB error: ' . $e->getMessage());
}

exit(0);
