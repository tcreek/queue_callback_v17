#!/usr/bin/php
/**
 * Queue Callback Store AGI Script
 * Stores callback requests in the database
 */

$stdin = fopen('php://stdin', 'r');
$stdout = fopen('php://stdout', 'w');

// Read initial AGI environment variables from Asterisk
$agi_vars = array();
while ($line = fgets($stdin)) {
    $line = trim($line);
    if ($line == '') break; // Empty line signals end of environment
    
    if (strpos($line, ':') !== false) {
        list($key, $value) = explode(':', $line, 2);
        $agi_vars[trim($key)] = trim($value);
    }
}

function agi_request($cmd) {
    global $stdin, $stdout;
    fputs($stdout, "$cmd\n");
    fflush($stdout);
    return trim(fgets($stdin));
}

try {
    // Get caller ID from AGI environment
    $callerid = isset($agi_vars['agi_callerid']) ? $agi_vars['agi_callerid'] : '';
    
    // Get variables set in dialplan
    $queue_result = agi_request("GET VARIABLE CALLBACK_QUEUE");
    $number_result = agi_request("GET VARIABLE CALLBACK_NUMBER");
    
    // Parse results
    preg_match('/result=1 \(([^)]*)\)/', $queue_result, $queue_matches);
    preg_match('/result=1 \(([^)]*)\)/', $number_result, $number_matches);
    
    $queue = isset($queue_matches[1]) ? $queue_matches[1] : '';
    $number = isset($number_matches[1]) ? $number_matches[1] : '';
    
    // If no callback number specified, use caller ID as callback number
    if (empty($number) && !empty($callerid)) {
        $number = $callerid;
    }
    
    if (!empty($callerid) || !empty($number)) {
        // Direct database connection
        $pdo = new PDO("mysql:host=localhost;dbname=asterisk", "freepbxuser", "55f88989cd6491e23706671e66750db4");
        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

        // Check for duplicate pending request
        if (!empty($queue) && !empty($number)) {
            $dup_check = $pdo->prepare("SELECT id FROM queuecallback_requests
                                        WHERE queue_id = ? AND callback_number = ? AND status = 'pending'");
            $dup_check->execute([$queue, $number]);
            if ($dup_check->fetch()) {
                agi_request("VERBOSE \"Duplicate callback request ignored for $number in queue $queue\"");
                exit;
            }
        }
        
        // Get queue position by checking current queue status
        $queue_position = 1; // Default position
        $queue_output = shell_exec("asterisk -rx 'queue show $queue' 2>/dev/null");
        if ($queue_output && preg_match('/W:(\d+)/', $queue_output, $matches)) {
            $queue_position = (int)$matches[1] + 1; // Their position is current waiting + 1
        }
        
        // Get max_attempts from queue configuration
        $config_sql = "SELECT max_attempts FROM queuecallback_config WHERE queue_id = ? AND enabled = 1";
        $config_stmt = $pdo->prepare($config_sql);
        $config_stmt->execute([$queue]);
        $config = $config_stmt->fetch(PDO::FETCH_ASSOC);
        $max_attempts = $config['max_attempts'] ?? 3;
        
        $sql = "INSERT INTO queuecallback_requests (queue_id, caller_id, callback_number, status, time_requested, attempts, max_attempts, position) VALUES (?, ?, ?, 'pending', ?, 0, ?, ?)";
        $stmt = $pdo->prepare($sql);
        $stmt->execute([$queue, $callerid, $number, time(), $max_attempts, $queue_position]);
    }
    
} catch (Exception $e) {
    // Silent error handling - don't log in production
}
?>
