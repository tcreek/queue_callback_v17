/** Read callback settings through FreePBX and fail closed on any error. */
$env = [];
while (($line = fgets(STDIN)) !== false) {
    $line = rtrim($line, "\r\n");
    if ($line === '') { break; }
    if (strpos($line, ':') !== false) {
        [$key, $value] = explode(':', $line, 2);
        $env[trim($key)] = ltrim($value, ' ');
    }
}
$library = dirname(__DIR__) . '/callback_fifo.php';
if (!is_file($library)) { $library = '/var/www/html/admin/modules/qcallback/callback_fifo.php'; }
try {
    if (!is_file($library)) {
        // Custom web roots are discovered through FreePBX configuration.
        global $amp_conf;
        ob_start(static function ($output) { return ''; });
        try { require_once '/etc/freepbx.conf'; } finally { ob_end_clean(); }
        $library = ($amp_conf['AMPWEBROOT'] ?? '/var/www/html') . '/admin/modules/qcallback/callback_fifo.php';
    }
    require_once dirname($library) . '/callback_requests.php';
    require_once $library;
    qcallback_fifo_agi($env, function (string $command): string {
        if (fwrite(STDOUT, $command . "\n") === false || !fflush(STDOUT)) {
            throw new RuntimeException('AGI output closed');
        }
        $reply = fgets(STDIN);
        if ($reply === false || rtrim($reply) === 'HANGUP') { throw new RuntimeException('AGI channel closed'); }
        return rtrim($reply, "\r\n");
    }, 'qcallback_agi_database');
} catch (Throwable $e) {
    error_log('Queue Callback: FIFO AGI could not initialize');
}
