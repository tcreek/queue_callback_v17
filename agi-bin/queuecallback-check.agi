/**
 * Queue Callback Check AGI Script
 * Checks if callback is enabled for the queue
 */

$stdin = fopen('php://stdin', 'r');
$stdout = fopen('php://stdout', 'w');

// Read initial AGI environment variables from Asterisk
$agi_vars = array();
while ($line = fgets($stdin)) {
    $line = trim($line);
    if ($line == '') break; // Empty line signals end of environment
    
    if (strpos($line, ':') !== false) {
        list($key, $value) = explode(':', $line, 2);
        $agi_vars[trim($key)] = trim($value);
    }
}

function agi_request($cmd) {
    global $stdin, $stdout;
    fputs($stdout, "$cmd\n");
    fflush($stdout);
    return trim(fgets($stdin));
}

try {
    // Get queue ID from dialplan variable
    $queue_result = agi_request("GET VARIABLE CALLBACK_QUEUE");
    preg_match('/result=1 \(([^)]*)\)/', $queue_result, $queue_matches);
    $queue_id = isset($queue_matches[1]) ? $queue_matches[1] : '';
    
    if (empty($queue_id)) {
        // Try to get from environment or use default
        $queue_id = $agi_vars['agi_dnid'] ?? '';
    }
    
    if (!empty($queue_id)) {
        // Load FreePBX config for database credentials
        require_once("/etc/freepbx.conf");
        $pdo = new PDO("mysql:host=" . $amp_conf["AMPDBHOST"] . ";dbname=" . $amp_conf["AMPDBNAME"], $amp_conf["AMPDBUSER"], $amp_conf["AMPDBPASS"]);
        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
        
        $sql = "SELECT enabled, callback_key FROM queuecallback_config WHERE queue_id = ?";
        $stmt = $pdo->prepare($sql);
        $stmt->execute([$queue_id]);
        $config = $stmt->fetch(PDO::FETCH_ASSOC);
        
        if ($config && $config['enabled']) {
            agi_request("SET VARIABLE QUEUE_CALLBACK_ENABLED 1");
            agi_request("SET VARIABLE QUEUE_CALLBACK_KEY " . ($config['callback_key'] ?: "*"));
            agi_request("VERBOSE \"Queue $queue_id has callback enabled with key " . ($config['callback_key'] ?: "*") . "\"");
        } else {
            agi_request("SET VARIABLE QUEUE_CALLBACK_ENABLED 0");
            agi_request("VERBOSE \"Queue $queue_id callback is disabled\"");
        }
    } else {
        agi_request("SET VARIABLE QUEUE_CALLBACK_ENABLED 0");
        agi_request("VERBOSE \"No queue ID found for callback check\"");
    }
    
} catch (Exception $e) {
    agi_request("VERBOSE \"Error checking callback config: " . $e->getMessage() . "\"");
    agi_request("SET VARIABLE QUEUE_CALLBACK_ENABLED 0");
}
